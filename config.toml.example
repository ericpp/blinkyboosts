# Named inputs. Several can share a type; every one feeds the same sat total and toggles.
[inputs.boostboard]
type = "boostboard"
relay_addrs = ["wss://relay.nostr.band"]
pubkey = "abcdef..."

[inputs.zaps]
type = "zaps"
relay_addrs = ["wss://relay.damus.io", "wss://nos.lol", "wss://relay.nostr.band"]
naddr = "naddr1qq9rzdesxvcnzwfjxgcsyg9e6qkt3lw7kxghq8kqvj8r0mgldta6yclqqc8uqcye5c59r5j7qspsgqqqwensfzsd4h"

[inputs.show_nwc]
type = "nwc"
uri = "nostr+walletconnect://abcdef..."

[inputs.guest_nwc]
type = "nwc"
enabled = false
uri = "nostr+walletconnect://fedcba..."

# SplitKit live socket. Broadcasts fired effects to every connected client.
# [inputs.splitkit]
# type = "splitkit"
# url = "wss://example.com/api/live/ws"

[outputs.osc]
type = "osc"
address = "127.0.0.1:7700"

[outputs.artnet]
type = "artnet"
broadcast_address = "255.255.255.255"
universe = 0

[outputs.sacn]
type = "sacn"
broadcast_address = ""
universe = 1

# OBS over obs-websocket v5. Switches the program scene, mutes an audio input,
# or shows and hides a source.
# [outputs.obs]
# type = "obs"
# host = "127.0.0.1"
# port = 4455            # optional, defaults to 4455
# password = "secret"    # optional, omit if OBS auth is disabled

[outputs.wled]
type = "wled"
# host = "192.168.2.84"
host = "192.168.2.114"
boost_playlist = "BOOST"
brightness = 128
setup = true
force = false

[[outputs.wled.segments]]
name = "BOOSTAGRAM"
start = 0
stop = 104
grouping = 1

[[outputs.wled.segments]]
name = "BOLT1"
start = 104
stop = 117
grouping = 2

[[outputs.wled.segments]]
name = "BALL"
start = 117
stop = 155
reverse = true
grouping = 2

[[outputs.wled.segments]]
name = "BOLT2"
start = 155
stop = 168
grouping = 2

[[outputs.wled.segments]]
name = "LIT"
start = 168
stop = 206
grouping = 3

