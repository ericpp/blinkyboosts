# ==============================================================================
# Actions and toggles
# ==============================================================================
# Define each command once under [actions.<name>], aimed at an output above.
# A single table is one command. Repeating [[actions.<name>]] is a scene:
# several commands, possibly to different outputs, under one name.
# Toggles only list those names. The same name can be used by many toggles.

[actions.seq1]
output = "osc"
path = "/gma3/cmd"
arg_value = "Go+ Sequence 1"

[actions.seq2]
output = "osc"
path = "/gma3/cmd"
arg_value = "Go+ Sequence 2"

[actions.seq3]
output = "osc"
path = "/gma3/cmd"
arg_value = "Go+ Sequence 3"

[actions.eos_cue]
output = "osc"
path = "/eos/cue/fire"
arg_value = 10

# Optional second OSC argument. Director Mini scene switches use it for the
# transition: 0 = cut, 1 = fade. Omit it to send a single argument.
[actions.scene2_fade]
output = "osc"
path = "/scene/switchByIndex"
arg_value = 2
arg_value2 = 1

[actions.artnet_full]
output = "artnet"
channel = 1
value = 255
# universe = 2  # Optional - uses the output's universe if omitted

[actions.artnet_dim]
output = "artnet"
channel = 5
value = 128
universe = 1  # Override the output's universe

[actions.sacn_full]
output = "sacn"
channel = 10
value = 255

[actions.sacn_dim]
output = "sacn"
channel = 20
value = 192
universe = 2

[actions.boost3]
output = "wled"
preset = "BOOST-3"  # Must match a preset or playlist name on the WLED device

[actions.bowl]
output = "wled"
preset = "Bowl After Bowl Anim"

[actions.boost0]
output = "wled"
preset = "BOOST-0"

# [actions.obs_cam2]
# output = "obs"
# scene = "Camera 2"
#
# muted = true mutes, false unmutes, and omitting it toggles.
# [actions.mic_off]
# output = "obs"
# input = "Mic/Aux"
# muted = true
#
# visible = true shows a source, false hides it, and omitting it toggles.
# Omit scene to use the current program scene. Sources inside a group are found too.
# [actions.logo_toggle]
# output = "obs"
# scene = "Scene 1"
# source = "Logo"

# One name covering lights and a strip together.
# hold_ms waits after that step before the next one. The last step's hold
# finishes before the next queued action starts. Actions run one job at a time,
# so a boost that arrives mid-sequence waits its turn. A boost is skipped when
# the same action names are already running or waiting.
[[actions.big_hit]]
output = "artnet"
channel = 1
value = 255
hold_ms = 1500
[[actions.big_hit]]
output = "wled"
preset = "BOOST-3"
hold_ms = 4000

# Toggles list action names. They are evaluated by threshold; if none match,
# default toggles (is_default = true) run.
[[toggles]]
threshold = 250_000
actions = ["seq1"]

[[toggles]]
threshold = 500_000
actions = ["seq2"]

[[toggles]]
threshold = 750_000
actions = ["seq3"]

[[toggles]]
threshold = 1_000_000
actions = ["eos_cue"]

[[toggles]]
threshold = 100_000
actions = ["artnet_full"]

[[toggles]]
threshold = 150_000
actions = ["artnet_dim"]

[[toggles]]
threshold = 200_000
actions = ["sacn_full"]

[[toggles]]
threshold = 350_000
actions = ["sacn_dim"]

[[toggles]]
threshold = 300_000
actions = ["boost3"]

[[toggles]]
threshold = 600_000
actions = ["bowl", "big_hit"]

[[toggles]]
is_default = true
actions = ["boost0"]

# A second default, and a revert that restores an earlier action after 30 seconds
# [[toggles]]
# is_default = true
# actions = ["seq1"]
#
# [[toggles]]
# threshold = 250_000
# revert_after = 30
# actions = ["big_hit"]
# revert = ["boost0"]

# Fires when SplitKit broadcasts an effect with this id. Ids are wide, dj,
# festoons, bubbles, and mystery. Effect toggles cannot also set a threshold,
# amount, or ending.
# [[toggles]]
# effect = "dj"
# revert_after = 30
# actions = ["big_hit"]
# revert = ["boost0"]
